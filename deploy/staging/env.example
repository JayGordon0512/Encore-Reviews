APP_NAME="Encore Reviews"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://staging.encorereviews.co.uk
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_LEVEL=warning

# PostgreSQL runs on the private Compose network. Nothing publishes its port.
DB_CONNECTION=pgsql
POSTGRES_DB=encore
POSTGRES_USER=encore
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://encore:change-me@database:5432/encore

CACHE_STORE=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log

FILESYSTEM_DISK=s3
ENCORE_EVENT_IMAGE_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=lon1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

MAIL_MAILER=smtp
MAIL_HOST=smtp.eu.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS=reviews@mg.encorereviews.co.uk
MAIL_FROM_NAME="Encore Reviews"

ENCORE_TICKETPAL_SECRET=
ENCORE_TICKETPAL_ORGANISER_LOGIN_URL=https://staging.ticketpal.co.uk/login
ENCORE_PROVIDER_V2_INGRESS_ENABLED=false
ENCORE_PROVIDER_V2_INVITATION_ISSUING_ENABLED=false
ENCORE_PROVIDER_V2_SIGNATURE_TOLERANCE=300
ENCORE_PROVIDER_V2_NONCE_RETENTION=900
ENCORE_PROVIDER_V2_INVITATION_DELAY_HOURS=2
ENCORE_PROVIDER_V2_TICKETPAL_CATALOGUE_STAGING_KEY_ID=
ENCORE_PROVIDER_V2_TICKETPAL_CATALOGUE_STAGING_SECRET=

ENCORE_CONTACT_FINGERPRINT_KEY=
ENCORE_CONTACT_FINGERPRINT_VERSION=1
ENCORE_INVITATION_TOKEN_DIGEST_KEY=
ENCORE_INVITATION_PREVIOUS_TOKEN_DIGEST_KEYS=
ENCORE_INVITATION_EXPIRY_DAYS=7
ENCORE_INVITATION_MAX_ATTEMPTS=3
ENCORE_INVITATION_RETRY_DELAY_MINUTES=15
ENCORE_INVITATION_CLAIM_TIMEOUT_MINUTES=5

# Keep disabled through infrastructure migration. Enable only after a controlled
# end-to-end invitation test confirms scheduler, queue and Mailgun operation.
ENCORE_ORGANISER_INVITATION_ISSUING_ENABLED=false
ENCORE_ORGANISER_INVITATION_DELAY_HOURS=2
ENCORE_AUDIENCE_IMPORT_MAX_ROWS=1000
ENCORE_EVENT_IMAGE_MAX_SIZE_KB=5120
